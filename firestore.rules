rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Super-admin de la plataforma: custom claim seteado vía Admin SDK
    // (scripts/set-super-admin.mjs). El claim viaja firmado en el token, así que
    // no hay identidad hardcodeada acá ni en el bundle del cliente.
    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.superAdmin == true;
    }

    function clinicDoc(clinicId) {
      return get(/databases/$(database)/documents/clinics/$(clinicId));
    }

    function clinicAdminUids(clinicId) {
      return clinicDoc(clinicId).data.get('adminUids', []);
    }

    function userClinicMembership(clinicId) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)/clinicMemberships/$(clinicId));
    }

    function isClinicAdmin(clinicId) {
      return isSuperAdmin()
        || (isSignedIn() && request.auth.uid in clinicAdminUids(clinicId))
        || (isSignedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid)/clinicMemberships/$(clinicId))
          && userClinicMembership(clinicId).data.role == 'admin');
    }

    function isClinicMember(clinicId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/clinicMemberships/$(clinicId));
    }

    function canAccessClinic(clinicId) {
      return isClinicAdmin(clinicId) || isClinicMember(clinicId);
    }

    // El member referenciado está reclamado por este uid (dueño del recurso).
    // Cuesta un get() por evaluación: usarlo solo en subcolecciones del member.
    function isMemberOwner(clinicId, memberId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/clinics/$(clinicId)/members/$(memberId)).data.uid == request.auth.uid;
    }

    // Plan / turno / cobro asignado a ESTE paciente. El memberId del doc tiene
    // que coincidir con el índice de membresía (no con Auth uid: el member se
    // crea con auto-id y el uid llega después, cuando reclama el acceso).
    function assignedToSignedInMember(clinicId) {
      return isClinicMember(clinicId)
        && 'memberId' in resource.data
        && resource.data.memberId is string
        && resource.data.memberId.size() > 0
        && resource.data.memberId == userClinicMembership(clinicId).data.memberId;
    }

    /**
     * Email vetado por el super-admin (ver match /blockedEmails).
     *
     * Funciona aunque la colección NO sea legible por el cliente: las rules leen
     * con privilegios propios, un exists() de acá no vuelve a aplicar las reglas
     * de lectura. Por eso la lista puede quedar cerrada al super-admin y el veto
     * igual se hace cumplir.
     *
     * OJO con el costo: cada exists() es una lectura facturada y cuenta contra el
     * límite de accesos por evaluación (10 por doc, 20 en batch). El alta de
     * pacientes escribe member + índice en un mismo batch, así que se chequea sólo
     * el email de acceso y no todas las variantes.
     */
    function isBlockedEmail(email) {
      // El guard NO es decorativo: un doc legacy sin `loginEmail`, o un token sin
      // email, harían explotar el `.lower()` y la regla denegaría por error —
      // dejando a un admin sin poder editar pacientes viejos. Con `&&` corta antes.
      return email is string
        && email.size() > 0
        && exists(/databases/$(database)/documents/blockedEmails/$(email.lower()));
    }

    // Data URL de imagen: valida header + size sin regex sobre el payload base64
    // (strings de 100–150KB con `.matches('...base64,.*')` pueden denegar la rule).
    function isDataImageUrl(s, maxSize) {
      return s is string
        && s.size() > 0
        && s.size() <= maxSize
        && s.split(',').size() == 2
        && s.split(',')[0] in [
          'data:image/png;base64',
          'data:image/jpeg;base64',
          'data:image/webp;base64'
        ];
    }

    function isHttpUrl(s, maxSize) {
      return s is string
        && s.size() > 0
        && s.size() <= maxSize
        && s.matches('https?://.*');
    }

    function isClaimingMembership() {
      return isSignedIn()
        && resource.data.uid == ''
        && resource.data.email == request.auth.token.email
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid'])
        // Imprescindible: claimPendingMemberships busca por collectionGroup sobre
        // (email, uid == '') y NO pasa por el índice de login, así que borrarle el
        // índice a un vetado no alcanza — sin este chequeo entraría por acá.
        && !isBlockedEmail(request.auth.token.email);
    }

    // photoURL editable por el paciente: solo si no cambia, o si el nuevo valor es
    // un data URL de imagen acotado o una URL http(s) corta. Evita que por API
    // directa se meta un payload gigante (DoS de doc) o un esquema peligroso.
    function selfPhotoUrlOk() {
      let d = request.resource.data;
      return !d.diff(resource.data).affectedKeys().hasAny(['photoURL'])
        || !('photoURL' in d)
        || isDataImageUrl(d.photoURL, 153600)
        || isHttpUrl(d.photoURL, 500);
    }

    // El paciente solo puede editar sus datos personales. La ficha clínica
    // (sex, medicalHistory, allergies, targetKcal, ...) queda admin-only por
    // omisión: cualquier otra key hace fallar el hasOnly.
    function isSelfProfileEdit() {
      return isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['fullName', 'phone', 'birthDate', 'photoURL'])
        && selfPhotoUrlOk();
    }

    function isSelfAuthStatusUpdate() {
      return isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['authStatus', 'passwordUpdatedAt', 'passwordResetRequestedAt']);
    }

    // ---- Perfil global ----
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow write: if isSignedIn() && request.auth.uid == uid;

      match /clinicMemberships/{clinicId} {
        allow read: if isSignedIn() && request.auth.uid == uid;
        // El propio usuario solo puede escribir su índice de membresía si refleja
        // fielmente un member doc que ya reclamó: mismo uid y MISMO role. El role
        // lo controla exclusivamente un admin (las ramas self-edit del member no
        // tocan `role`), así que esto impide auto-asignarse `role: 'admin'`.
        allow write: if isSuperAdmin()
          || isClinicAdmin(clinicId)
          || (isSignedIn()
              && request.auth.uid == uid
              && request.resource.data.keys().hasOnly(['memberId', 'role'])
              && exists(/databases/$(database)/documents/clinics/$(clinicId)/members/$(request.resource.data.memberId))
              && get(/databases/$(database)/documents/clinics/$(clinicId)/members/$(request.resource.data.memberId)).data.uid == request.auth.uid
              && get(/databases/$(database)/documents/clinics/$(clinicId)/members/$(request.resource.data.memberId)).data.role == request.resource.data.role);
      }
    }

    // ---- Planes de suscripción (catálogo de la plataforma) ----
    // Lectura pública: la landing de marketing muestra los precios en vivo.
    // Catálogo comercial sin PII; escribe solo el super-admin.
    match /plans/{planId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ---- Emails vetados (moderación de la plataforma) ----
    // Lista cerrada: SOLO el super-admin la lee y la escribe. A diferencia de
    // memberLoginIndex, no hace falta exponerla para que sirva — `isBlockedEmail()`
    // la consulta desde las rules, que leen con privilegios propios. Mantenerla
    // cerrada evita que se pueda enumerar/adivinar quién está vetado y que el
    // campo `reason` (una nota interna) quede a la vista.
    //
    // Un email vetado no da un mensaje distinto en el login: al vetarlo se borra
    // su entrada del índice, así que el flujo responde igual que con un email que
    // nunca existió (ver blockedEmailsService.blockEmail).
    match /blockedEmails/{emailKey} {
      function validBlocked() {
        let d = request.resource.data;
        return d.keys().hasOnly(['email', 'reason', 'createdAt'])
          && d.email is string && d.email.size() <= 200
          // La clave del doc DEBE ser el email normalizado: es lo que hace que
          // isBlockedEmail() pueda resolver por path, sin queries.
          && emailKey == d.email.lower()
          && (!('reason' in d) || (d.reason is string && d.reason.size() <= 300))
          && d.createdAt == request.time;
      }
      allow read: if isSuperAdmin();
      allow create, update: if isSuperAdmin() && validBlocked();
      allow delete: if isSuperAdmin();
    }

    // Índice de lookup por email para el login (legible sin auth para poder rutear
    // el flujo antes de autenticar). Como es world-readable, la forma se valida en
    // escritura para que NO contenga PII de más (nombre completo, rol): solo lo
    // mínimo que el login necesita.
    match /memberLoginIndex/{emailKey} {
      function validLoginIndex() {
        let d = request.resource.data;
        return d.keys().hasOnly(['email', 'clinicId', 'clinicName', 'memberId'])
          && (!('email' in d) || (d.email is string && d.email.size() <= 200))
          && (!('clinicId' in d) || (d.clinicId is string && d.clinicId.size() <= 200))
          && (!('clinicName' in d) || (d.clinicName is string && d.clinicName.size() <= 120))
          && (!('memberId' in d) || (d.memberId is string && d.memberId.size() <= 200));
      }
      // La clave del doc DEBE ser el email (normalizado) que declara el payload:
      // impide que un admin escriba/reapunte el índice de un email ajeno
      // (envenenamiento cross-tenant del ruteo de login).
      function keyMatchesEmail() {
        return 'email' in request.resource.data
          && emailKey == request.resource.data.email.lower();
      }
      allow get: if true;
      allow list: if false;
      allow create, update: if validLoginIndex()
        && keyMatchesEmail()
        // Email vetado: el índice no se puede volver a crear. Cubre las tres vías
        // por las que reaparecería solo — el alta de un paciente, el backfill de la
        // lista de pacientes, y el updateMemberAuthStatus del propio paciente al entrar.
        && !isBlockedEmail(request.resource.data.email)
        // No re-apuntar un índice existente a otro consultorio.
        && (resource == null || resource.data.clinicId == request.resource.data.clinicId)
        && (isClinicAdmin(request.resource.data.clinicId)
          || (isSignedIn()
            && get(/databases/$(database)/documents/clinics/$(request.resource.data.clinicId)/members/$(request.resource.data.memberId)).data.uid == request.auth.uid));
      allow delete: if isClinicAdmin(resource.data.clinicId);
    }

    // ---- Presentación pública del consultorio (para prospectos, sin login) ----
    // Legible por cualquiera; escribible solo por admin del consultorio o super-admin.
    // NO contiene datos sensibles: snapshot de marca + datos de contacto públicos.
    // Como es de lectura pública, validamos forma y tamaños para que un admin no
    // pueda escribir campos arbitrarios ni payloads enormes en un doc world-readable.
    match /publicProfiles/{clinicId} {
      function validPresentation() {
        let d = request.resource.data;
        return d.keys().hasOnly([
            'id', 'name', 'logoURL', 'theme', 'description', 'videos', 'links', 'tariffs',
            'whatsapp', 'email', 'address', 'openingHours', 'updatedAt'
          ])
          && (!('name' in d) || (d.name is string && d.name.size() <= 120))
          && (!('description' in d) || (d.description is string && d.description.size() <= 2000))
          && (!('videos' in d) || (d.videos is list && d.videos.size() <= 6))
          && (!('links' in d) || (d.links is list && d.links.size() <= 12))
          && (!('tariffs' in d) || (d.tariffs is list && d.tariffs.size() <= 20))
          && (!('whatsapp' in d) || (d.whatsapp is string && d.whatsapp.size() <= 40))
          && (!('email' in d) || (d.email is string && d.email.size() <= 200))
          && (!('address' in d) || (d.address is string && d.address.size() <= 200))
          && (!('openingHours' in d) || (d.openingHours is string && d.openingHours.size() <= 200))
          && (!('logoURL' in d) || isDataImageUrl(d.logoURL, 153600));
      }
      // El logo del perfil público debe reflejar el de `clinics/{clinicId}` (que ya
      // está rate-limiteado). Así el mirror world-readable hereda el límite sin
      // duplicar contadores, y no puede divergir del logo real.
      function logoMirrorsClinic() {
        let d = request.resource.data;
        return !('logoURL' in d)
          || (resource != null && !d.diff(resource.data).affectedKeys().hasAny(['logoURL']))
          || (exists(/databases/$(database)/documents/clinics/$(clinicId))
              && d.logoURL == clinicDoc(clinicId).data.get('logoURL', null));
      }
      allow read: if true;
      allow create, update: if isClinicAdmin(clinicId) && validPresentation() && logoMirrorsClinic();
      allow delete: if isClinicAdmin(clinicId);
    }

    match /clinics/{clinicId} {
      // Rate-limit del logo: máximo 3 cambios por ventana fija de 24hs, y tope de
      // tamaño del data URL (el logo se guarda inline como string en el doc).
      // El cliente manda logoWindowStart (serverTimestamp) + logoChangeCount.
      function logoLimitOk() {
        let d = request.resource.data;
        return !d.diff(resource.data).affectedKeys().hasAny(['logoURL'])
          || (
            (!('logoURL' in d) || isDataImageUrl(d.logoURL, 153600))
            && (
              // Ventana nueva: primera vez o la anterior ya venció.
              (d.get('logoWindowStart', null) == request.time
                && d.get('logoChangeCount', 99) == 1
                && (!('logoWindowStart' in resource.data)
                  || resource.data.logoWindowStart + duration.value(24, 'h') < request.time))
              ||
              // Misma ventana: suma exactamente 1, hasta 3.
              (d.get('logoWindowStart', null) == resource.data.get('logoWindowStart', null)
                && d.get('logoChangeCount', 99) == resource.data.get('logoChangeCount', 0) + 1
                && d.get('logoChangeCount', 99) <= 3)
            )
          );
      }

      // Un admin NO puede tocar la facturación ni la propiedad del consultorio: el
      // plan, la cuota y el estado de suscripción (subscription) y el dueño
      // (ownerUid) los gestiona SOLO el super-admin. Sin esto, un admin podría
      // auto-asignarse el plan premium o marcar su suscripción como paga.
      // `settings` (configuración de trabajo) SÍ es editable por el admin.
      function adminSafeClinicUpdate() {
        return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['subscription', 'ownerUid']);
      }

      allow read: if canAccessClinic(clinicId) || isSuperAdmin();
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin()
        || (isClinicAdmin(clinicId) && logoLimitOk() && adminSafeClinicUpdate());
      allow delete: if isSuperAdmin();

      // ---- Pacientes / membresías ----
      match /members/{memberId} {
        allow read: if isClinicAdmin(clinicId)
          || (isSignedIn() && resource.data.uid == request.auth.uid)
          || (isSignedIn() && resource.data.email == request.auth.token.email);

        // Un admin no puede dar de alta un paciente con un email vetado. Se chequea
        // `loginEmail` (el email de acceso) y no también `email`: son iguales en
        // las altas por UI, y cada exists() extra gasta presupuesto de accesos
        // dentro del batch que escribe member + índice juntos.
        allow create: if isClinicAdmin(clinicId) && !isBlockedEmail(request.resource.data.get('loginEmail', ''));
        allow delete: if isClinicAdmin(clinicId);

        // El blanqueo de acceso pasa por acá, así que también se bloquea reapuntar
        // un paciente existente a un email vetado.
        allow update: if (isClinicAdmin(clinicId) && !isBlockedEmail(request.resource.data.get('loginEmail', '')))
          || isClaimingMembership()
          || isSelfProfileEdit()
          || isSelfAuthStatusUpdate();

        // Notas clínicas: SOLO admin, doble barrera (ni el propio paciente las lee).
        match /notes/{noteId} {
          allow read, write: if isClinicAdmin(clinicId);
        }

        // Antropometría: la carga el profesional en consulta. El paciente puede
        // ver su propia evolución, pero nunca escribirla.
        match /anthropometry/{recordId} {
          allow read: if isClinicAdmin(clinicId) || isMemberOwner(clinicId, memberId);
          allow write: if isClinicAdmin(clinicId);
        }

        // Diario alimentario del paciente. Lo escribe el propio paciente, así que
        // se valida forma y tamaño (único lugar de la app con fotos del paciente).
        match /diary/{entryId} {
          function validDiaryEntry() {
            let d = request.resource.data;
            return d.keys().hasOnly(['dayKey', 'slot', 'status', 'note', 'photoURL', 'updatedAt'])
              && d.dayKey is string && d.dayKey.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
              && d.slot in ['desayuno', 'colacion_am', 'almuerzo', 'merienda', 'colacion_pm', 'cena']
              && d.status in ['done', 'partial', 'skipped']
              && (!('note' in d) || (d.note is string && d.note.size() <= 500))
              && (!('photoURL' in d) || isDataImageUrl(d.photoURL, 153600))
              && (!('updatedAt' in d) || d.updatedAt is timestamp);
          }
          // Ata el doc-id a (dayKey, slot): un doc por comida por día; no se puede
          // desdoblar el día ni pisar otra comida.
          function diaryIdBound() {
            return entryId == request.resource.data.dayKey + '_' + request.resource.data.slot;
          }
          allow read: if isClinicAdmin(clinicId) || isMemberOwner(clinicId, memberId);
          allow create, update: if isMemberOwner(clinicId, memberId) && validDiaryEntry() && diaryIdBound();
          allow delete: if isClinicAdmin(clinicId) || isMemberOwner(clinicId, memberId);
        }

        // Peso autorreportado: 1 registro por día (id = dayKey).
        match /weightLogs/{dayKey} {
          function validWeightLog() {
            let d = request.resource.data;
            return d.keys().hasOnly(['dayKey', 'weightKg', 'note', 'date'])
              && d.dayKey is string && d.dayKey.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
              && dayKey == d.dayKey
              && d.weightKg is number && d.weightKg >= 20 && d.weightKg <= 400
              && (!('note' in d) || (d.note is string && d.note.size() <= 200))
              && (!('date' in d) || d.date is timestamp);
          }
          allow read: if isClinicAdmin(clinicId) || isMemberOwner(clinicId, memberId);
          allow create, update: if isMemberOwner(clinicId, memberId) && validWeightLog();
          allow delete: if isClinicAdmin(clinicId) || isMemberOwner(clinicId, memberId);
        }

        // Check-in semanal: 1 por semana (id = weekKey 'YYYY-Www').
        match /checkIns/{weekKey} {
          function validCheckIn() {
            let d = request.resource.data;
            return d.keys().hasOnly(['weekKey', 'energy', 'sleep', 'hunger', 'adherence', 'comment', 'date'])
              && d.weekKey is string && d.weekKey.matches('[0-9]{4}-W[0-9]{2}')
              && weekKey == d.weekKey
              && d.energy is int && d.energy >= 1 && d.energy <= 10
              && d.sleep is int && d.sleep >= 1 && d.sleep <= 10
              && d.hunger is int && d.hunger >= 1 && d.hunger <= 10
              && d.adherence is int && d.adherence >= 1 && d.adherence <= 10
              && (!('comment' in d) || (d.comment is string && d.comment.size() <= 1000))
              && (!('date' in d) || d.date is timestamp);
          }
          allow read: if isClinicAdmin(clinicId) || isMemberOwner(clinicId, memberId);
          allow create, update: if isMemberOwner(clinicId, memberId) && validCheckIn();
          allow delete: if isClinicAdmin(clinicId) || isMemberOwner(clinicId, memberId);
        }
      }

      match /tariffs/{tariffId} {
        allow read: if canAccessClinic(clinicId);
        allow write: if isClinicAdmin(clinicId);
      }

      // Catálogo de alimentos del consultorio (seed + custom del profesional).
      match /foods/{foodId} {
        allow read: if canAccessClinic(clinicId);
        allow write: if isClinicAdmin(clinicId);
      }

      // Planes alimentarios. El paciente solo ve los asignados a su member
      // (templates llevan memberId '' → invisibles). El list filtra
      // where('memberId','==', membership.memberId).
      match /mealPlans/{planId} {
        allow read: if isClinicAdmin(clinicId)
          || assignedToSignedInMember(clinicId)
          || (isSignedIn() && resource.data.memberUid == request.auth.uid);
        allow write: if isClinicAdmin(clinicId);
      }

      // Turnos: el paciente ve los propios y solo puede confirmar (status →
      // 'confirmed', sin tocar nada más). Todo lo demás lo gestiona el admin.
      match /appointments/{appointmentId} {
        function validAppointment() {
          let d = request.resource.data;
          return d.keys().hasOnly([
              'memberId', 'memberUid', 'memberName', 'dayKey', 'startAt', 'durationMin',
              'type', 'tariffId', 'status', 'notes', 'createdBy', 'createdAt'
            ])
            && d.memberId is string && d.memberId.size() <= 200
            && d.memberUid is string && d.memberUid.size() <= 128
            && (!('memberName' in d) || (d.memberName is string && d.memberName.size() <= 160))
            && d.dayKey is string && d.dayKey.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
            && d.startAt is timestamp
            && d.durationMin is int && d.durationMin >= 5 && d.durationMin <= 480
            && d.status in ['scheduled', 'confirmed', 'completed', 'cancelled', 'no_show']
            && (!('notes' in d) || (d.notes is string && d.notes.size() <= 1000));
        }
        function isConfirmingOwnAppointment() {
          return assignedToSignedInMember(clinicId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status == 'confirmed';
        }
        allow read: if isClinicAdmin(clinicId)
          || assignedToSignedInMember(clinicId)
          || (isSignedIn() && resource.data.memberUid == request.auth.uid);
        allow create: if isClinicAdmin(clinicId) && validAppointment();
        allow update: if (isClinicAdmin(clinicId) && validAppointment())
          || isConfirmingOwnAppointment();
        allow delete: if isClinicAdmin(clinicId);
      }

      // Cobros a pacientes (servicios realizados). Escribe SOLO el admin; el
      // paciente lee los propios (list con where memberId == membership.memberId).
      match /payments/{paymentId} {
        function validPatientPayment() {
          let d = request.resource.data;
          return d.keys().hasOnly([
              'memberId', 'memberUid', 'memberName', 'serviceType', 'tariffId',
              'amount', 'date', 'comment', 'createdBy'
            ])
            && d.memberId is string && d.memberId.size() <= 200
            && d.memberUid is string && d.memberUid.size() <= 128
            && (!('memberName' in d) || (d.memberName is string && d.memberName.size() <= 160))
            && d.serviceType in ['consulta', 'tratamiento', 'antropometria', 'otro']
            && d.amount is number && d.amount > 0
            && (!('comment' in d) || (d.comment is string && d.comment.size() <= 500));
        }
        allow read: if isClinicAdmin(clinicId)
          || assignedToSignedInMember(clinicId)
          || (isSignedIn() && resource.data.memberUid == request.auth.uid);
        allow create, update: if isClinicAdmin(clinicId) && validPatientPayment();
        allow delete: if isClinicAdmin(clinicId);
      }

      // Cuotas SaaS del consultorio a la plataforma (las gestiona el super-admin;
      // el admin puede ver su propio historial).
      match /subscriptionPayments/{paymentId} {
        allow read: if isClinicAdmin(clinicId) || isSuperAdmin();
        allow write: if isSuperAdmin();
      }

      match /stats/{docId} {
        allow read, write: if isClinicAdmin(clinicId);
      }
    }
  }
}
