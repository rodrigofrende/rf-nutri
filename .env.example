# Firebase web app config — copiar a .env.local y completar con los valores del proyecto
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Poner en "true" para conectar a los emuladores locales (firebase emulators:start)
VITE_USE_FIREBASE_EMULATOR=false

# Login con Google. Dejar en "false" si los accesos son claves internas tipo usuario@consultorio.com
VITE_ENABLE_GOOGLE_LOGIN=false

# App Check (reCAPTCHA v3): clave de sitio para atestar que las requests vienen
# de la app real. Sin esto, App Check no se inicializa. Crear la key en:
# consola Firebase → App Check → Apps → reCAPTCHA v3.
VITE_RECAPTCHA_V3_SITE_KEY=
# Solo desarrollo/CI: token de debug para App Check (consola → App Check → Debug
# tokens). "true" imprime uno nuevo en consola del navegador; o pegar uno fijo.
# NUNCA setear en producción.
# VITE_APPCHECK_DEBUG_TOKEN=true

# Modo demo (datos en memoria, sin Firebase). Debe ser explícito: si no está en
# "true" y faltan credenciales, la app falla al iniciar (no cae a demo sola).
# VITE_DEMO_MODE=true

# Topic de ntfy donde llegan los avisos de error de producción y los de deploy
# (src/utils/errorReporting.ts y scripts/notify-deploy.mjs).
#
# NO ES UN SECRETO: Vite inlinea las VITE_* en el bundle, así que el nombre del
# topic es público y cualquiera que lea el JS puede suscribirse a tus avisos o
# publicar avisos falsos. Está como variable para tener una sola fuente de verdad
# y poder rotarlo desde Netlify sin commitear. Por eso el reporter NUNCA manda
# PII en claro (el email del paciente va enmascarado, ver src/utils/privacy.ts).
#
# Vacío o ausente = no se reporta nada. Hay que cargarlo en Netlify para que
# funcione en producción.
VITE_NTFY_TOPIC=
